{
	"name": "todo-dashboard",
	"private": true,
	"version": "1.2.146",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:svelte": "vite dev",
		"dev:pocketbase": "pocketbase serve --http 127.0.0.1:8090",
		"dev:all": "node scripts/dev-all.mjs",
		"build": "vite build",
		"build:static": "vite build",
		"build:pocketbase-public": "npm run build:static && node scripts/copy-build-to-pocketbase.mjs",
		"preview": "vite preview",
		"preview:static": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-preprocess": "^6.0.3",
		"typescript": "^5.0.0",
		"vite": "^6.3.5",
		"vite-plugin-singlefile": "^2.2.0"
	},
	"dependencies": {
		"pocketbase": "^0.27.3"
	}
}
